# Merge into Identity and every enabled model worker's PRIVATE environment.
# Never put real credentials in this tracked template.
NODE_ENV=production
MODEL_EXECUTION_ENABLED=false
MODEL_PRODUCTION_APPROVED=false
# Trial: comma-separated UUIDs. General release: * only after explicit approval.
MODEL_ALLOWED_ACCOUNT_IDS=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
# Optional per-purpose routing within the currently authorized OpenAI provider.
MODEL_NAME_TEXT_REPLY=
MODEL_NAME_LETTER_REPLY=
MODEL_NAME_GATHER_REPLY=
MODEL_NAME_PHOTO_REPLY=
MODEL_NAME_MEMORY_SUGGEST=
MODEL_NAME_AUTOMATIC_MEMORY=
MODEL_NAME_MEMORY_ECHO=
MODEL_NAME_WORLD_ACTION=
MODEL_NAME_STORY_BRANCH=
MODEL_NAME_OFFLINE_LIFE=
MODEL_NAME_GIFT_RETURN=
# Absolute private file, regular file, 0600 on Unix; restricted user/service ACL on Windows.
MODEL_API_KEY_FILE=
MODEL_MAX_CONCURRENT=4
MODEL_DAILY_ACCOUNT_LIMIT=100
# HTTPS service origin with no path; use a trusted private CA when appropriate.
XIJIE_IDENTITY_URL=https://identity.internal.example.test:9443
# Each worker reads its own role, not another service role. Configure on Identity too.
XIJIE_CONVERSATIONS_SERVICE_TOKEN=
XIJIE_MEMORIES_SERVICE_TOKEN=
XIJIE_SOCIAL_SERVICE_TOKEN=
XIJIE_GIFTS_SERVICE_TOKEN=
# Private CA trust file if your internal endpoints use a private CA. Never disable TLS validation.
NODE_EXTRA_CA_CERTS=
# These remain independent opt-ins in their own service environments.
AUTOMATIC_MEMORY_ENABLED=false
SOCIAL_AI_ENABLED=false
GIFTS_AI_ENABLED=false
REFERRALS_ENABLED=false
REFERRALS_PRODUCTION_APPROVED=false
SHARED_ALBUMS_ENABLED=false
SHARED_ALBUMS_PRODUCTION_APPROVED=false
# Conversations only: independent current person_voice_calls + production v2 consent required.
# Official Realtime WebSocket proxy; no audio recording or persistent transcript.
VOICE_CALLS_ENABLED=false
VOICE_MODEL=gpt-realtime-2.1
# 1..120, default 60 seconds. Each live voice attempt gets a central 150-second lease.
VOICE_CALL_MAX_SECONDS=60
