# Private Identity configuration. Providers remain unavailable unless explicitly enabled.
OIDC_APPLE_ENABLED=false
OIDC_GOOGLE_ENABLED=false
OIDC_WECHAT_ENABLED=false
OIDC_NATIVE_HANDOFF_ENABLED=false
# Official WeChat mobile connector instance ID and public AppID. Keep disabled until configured.
OIDC_WECHAT_NATIVE_ENABLED=false
LOGTO_WECHAT_NATIVE_CONNECTOR_ID=
WECHAT_NATIVE_APP_ID=
# Fixed Logto issuer, NOT the Apple or WeChat issuer.
OIDC_ISSUER=https://identity-provider.example.test/oidc
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=https://app.example.test/v1/auth/callback
OIDC_CLIENT_REGISTRATION_KEY=web-production
# Self-hosted Logto 1.46: independent role with SELECT only on the fixed tenant phone view.
# Use a private TLS database address and sslmode=verify-full in production.
LOGTO_ACCOUNT_READ_DATABASE_URL=
# Alternative only for a provider deployment that REALLY exposes read:users; mutually exclusive.
LOGTO_ACCOUNT_READ_CLIENT_ID=
LOGTO_ACCOUNT_READ_CLIENT_SECRET=
LOGTO_ACCOUNT_READ_RESOURCE=
