# 字段说明模板；正常流程由 prepare-local.py 生成私有 checkout.env。
# 不在本文件填写真实值。五项基础设施密码分别使用随机64位小写十六进制，不能复用。
# 这些不是微信／支付宝／西界的商户密钥。
JEEPAY_DB_ROOT_PASSWORD=
JEEPAY_DB_PASSWORD=
JEEPAY_REDIS_PASSWORD=
JEEPAY_MANAGER_JWT_SECRET=
JEEPAY_MERCHANT_JWT_SECRET=

# 以下绝对路径／独立项目名由 prepare-local.py 按新目录生成。
JEEPAY_IMAGE_PREFIX=
JEEPAY_DEPLOY_DIR=
JEEPAY_UI_DOCKERFILE=
JEEPAY_BOOTSTRAP_SQL=
# jeepay/ 与 jeepay-ui/ 为同级目录。
UI_BASE_DIR=..
JEEPAY_API_PORT=29116
JEEPAY_CASHIER_PORT=29226
JEEPAY_MANAGER_UI_PORT=29227
JEEPAY_MERCHANT_UI_PORT=29228

# prepare-local.py 从 source-lock.json 复制这些固定 repo@sha256 值。
# Maven 构建镜像另存于私有 deployment.json；不使用上游浮动默认标签。
MYSQL_IMAGE=
REDIS_IMAGE=
ROCKETMQ_IMAGE=
JEEPAY_JRE_IMAGE=
JEEPAY_NODE_IMAGE=
JEEPAY_NGINX_IMAGE=

# 运营账号随机密码为独立的 bootstrap-password 文件，由构建生成私有首启SQL。
# 不把该密码当作 env 插值，也不重新初始化已有数据库来改密码。
