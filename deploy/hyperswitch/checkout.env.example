# 西界 Gifts 服务端配置片段。复制到私有 env 后填写；真实密钥不写此模板。
# 完整字段与商品配置见 backend/services/gifts/.env.example。
GIFTS_COMMERCE_ENABLED=false
GIFTS_COMMERCE_PROVIDERS=hyperswitch
GIFTS_COMMERCE_PRODUCTS_FILE=
GIFTS_PUBLIC_ORIGIN=
GIFTS_WEB_ORIGIN=

# 你的自部署 Hyperswitch API，不预设 Hyperswitch Cloud 地址。
HYPERSWITCH_API_ORIGIN=
# 逗号分隔的 HTTPS 收银链接允许源；通常包含你自建网关的公开源。
HYPERSWITCH_CASHIER_ORIGINS=
# 此处为商户 API key，不能填 admin-api-key，也不能填 Stripe/PayPal key。
HYPERSWITCH_API_KEY=
HYPERSWITCH_MERCHANT_ID=
HYPERSWITCH_PROFILE_ID=
# 与所选 business profile 的 payment_response_hash_key 相同。
HYPERSWITCH_WEBHOOK_SECRET=
# 配置标签不是支付响应中的 livemode；还需核对实际 connector 及凭据环境。
HYPERSWITCH_ENVIRONMENT=sandbox

# Stripe/PayPal/Apple/Google 凭据均在你自建的 Hyperswitch 控制台配置。
# 本模板不被 Hyperswitch router 直接读取，也不生成商户或自动启用任何钱包。
