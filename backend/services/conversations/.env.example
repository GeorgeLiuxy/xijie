# Dedicated PostgreSQL database. Do not point this service at Identity or People databases.
DATABASE_URL=postgresql://conversations:CHANGE_ME@127.0.0.1:5435/xijie_conversations
CONVERSATIONS_HOST=127.0.0.1
CONVERSATIONS_PORT=3103
CONVERSATIONS_WEB_ORIGIN=http://127.0.0.1:5184
CONVERSATIONS_QUEUE_SCHEMA=conversation_queue
XIJIE_IDENTITY_URL=http://127.0.0.1:3101
XIJIE_PEOPLE_URL=http://127.0.0.1:3102
# Generate a random 64-hex service credential; use the same value on all three services.
XIJIE_CONVERSATIONS_SERVICE_TOKEN=
# Optional K04 integration; configure when the memories service is deployed.
XIJIE_MEMORIES_URL=
XIJIE_MEMORIES_SERVICE_TOKEN=

# K05 only. Share a separately generated 64-hex credential with the Identity rights worker.
XIJIE_DATA_RIGHTS_SERVICE_TOKEN=

# Shared transport for separate chat and letter providers; letters require independent
# Identity letterStorage/letterReplies permissions. No letter body goes through chat generation.
# Optional model configuration. A missing setting leaves accepted messages saved,
# and the generation job fails with MODEL_NOT_CONFIGURED instead of a fabricated reply.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
# Explicitly authorized local development account UUIDs, comma-separated; empty blocks calls.
# Production also requires explicit approval, a private key file and the user's current production consent.
MODEL_ALLOWED_ACCOUNT_IDS=
MODEL_EXECUTION_ENABLED=false
MODEL_PRODUCTION_APPROVED=false
MODEL_API_KEY_FILE=
MODEL_MAX_CONCURRENT=4
MODEL_DAILY_ACCOUNT_LIMIT=100
# Independent voice call capability. Uses the same private official OpenAI key and central budgets.
# Audio samples are never sent or cloned; only standard built-in synthetic voices are selected.
VOICE_CALLS_ENABLED=false
VOICE_MODEL=gpt-realtime-2.1
VOICE_CALL_MAX_SECONDS=60

# Separately opted-in direct reply speech pilot. Keep false unless Identity 035 and
# Conversations 016 are deployed and the selected model is enabled for the account.
CONVERSATIONS_SPEECH_ENABLED=false
CONVERSATIONS_SPEECH_MODEL=
# Set VITE_CONVERSATIONS_SPEECH_ENABLED=true in the frontend build for this deployment only.

# Integration tests create and drop only their own randomly named schemas in this database.
XIJIE_TEST_DATABASE_URL=

# Independent Gifts role.
XIJIE_GIFTS_SERVICE_TOKEN=
XIJIE_GIFTS_URL=http://127.0.0.1:3107
XIJIE_MEDIA_URL=http://127.0.0.1:3106
# Incoming Media service identity; outgoing calls use Conversations' own token.
XIJIE_MEDIA_SERVICE_TOKEN=
XIJIE_CONTENT_REVIEW_SERVICE_TOKEN=
