# Dedicated People PostgreSQL; never share the Identity database.
DATABASE_URL=postgresql://people:CHANGE_ME@127.0.0.1:5434/xijie_people
PEOPLE_PORT=3102
PEOPLE_WEB_ORIGIN=http://127.0.0.1:5184
XIJIE_IDENTITY_URL=http://127.0.0.1:3101
XIJIE_PEOPLE_SERVICE_TOKEN=
XIJIE_CONVERSATIONS_SERVICE_TOKEN=
XIJIE_MEMORIES_SERVICE_TOKEN=
# Social can read only its dedicated metadata/source endpoints; never reuse another role token.
XIJIE_SOCIAL_SERVICE_TOKEN=
# K05 internal endpoints stay disabled unless a separate 64-hex worker credential is set.
XIJIE_DATA_RIGHTS_SERVICE_TOKEN=

# Media binds only the independently authorized person-photo purpose.
XIJIE_MEDIA_URL=http://127.0.0.1:3106
XIJIE_MEDIA_SERVICE_TOKEN=

# Independent Gifts role.
XIJIE_GIFTS_SERVICE_TOKEN=
