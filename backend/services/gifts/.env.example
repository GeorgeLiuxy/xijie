DATABASE_URL=postgres://xijie_gifts:replace@127.0.0.1:5439/xijie_gifts
GIFTS_HOST=127.0.0.1
GIFTS_PORT=3107
GIFTS_WEB_ORIGIN=http://127.0.0.1:5184
XIJIE_IDENTITY_URL=http://127.0.0.1:3101
XIJIE_PEOPLE_URL=http://127.0.0.1:3102
XIJIE_CONVERSATIONS_URL=http://127.0.0.1:3103
# Optional. Configure to enable the existing worker's first-memory referral polling.
# Uses XIJIE_GIFTS_SERVICE_TOKEN; no trial, AI, or storage consent is granted.
XIJIE_MEMORIES_URL=
# Optional distinct incoming credential for the fixed shared-album promotion endpoint.
XIJIE_SOCIAL_SERVICE_TOKEN=
# Configure both to enable journey-photo endpoints; absent together preserves existing Gifts flows.
XIJIE_MEDIA_URL=
XIJIE_MEDIA_SERVICE_TOKEN=
XIJIE_GIFTS_SERVICE_TOKEN=
XIJIE_CONVERSATIONS_SERVICE_TOKEN=
XIJIE_DATA_RIGHTS_SERVICE_TOKEN=
GIFTS_TRIAL_ISSUANCE_ENABLED=false
GIFTS_SYNTHETIC_ACCOUNT_IDS=
# Shared feature switch only. Acceptance captures consent without reading model configuration.
GIFTS_AI_ENABLED=false
# Self-hosted cashiers. Keep disabled until private merchant/product setup.
# Select jeepay, hyperswitch, or both. Never place these secrets in VITE_* variables.
GIFTS_COMMERCE_ENABLED=false
GIFTS_COMMERCE_PROVIDERS=jeepay,hyperswitch
# Absolute path to explicitly approved products; no price/SKU is assumed.
GIFTS_COMMERCE_PRODUCTS_FILE=
# Public Gifts API origin for JeePay callbacks; same-origin reverse proxy is supported.
GIFTS_PUBLIC_ORIGIN=
JEEPAY_GATEWAY_ORIGIN=
JEEPAY_CASHIER_ORIGINS=
JEEPAY_MCH_NO=
JEEPAY_APP_ID=
# JeePay merchant application secret, not an Alipay/WeChat signing key.
JEEPAY_APP_SECRET=
# Self-hosted Hyperswitch v1 API and public payment-link origin(s).
HYPERSWITCH_API_ORIGIN=
HYPERSWITCH_CASHIER_ORIGINS=
HYPERSWITCH_API_KEY=
HYPERSWITCH_MERCHANT_ID=
HYPERSWITCH_PROFILE_ID=
# Profile payment_response_hash_key; verifies X-Webhook-Signature-512.
HYPERSWITCH_WEBHOOK_SECRET=
HYPERSWITCH_ENVIRONMENT=sandbox
# Financial retention is an explicit issuer policy, with no assumed legal term.
# Leave both empty until the issuer approves a version and number of days.
GIFTS_FINANCIAL_RETENTION_POLICY_VERSION=
GIFTS_FINANCIAL_RETENTION_DAYS=
# Dedicated local operator CLI only. Never reuse any service token here.
GIFTS_OPERATOR_ENABLED=false
XIJIE_FINANCIAL_OPERATOR_TOKEN=
# Absolute private regular file containing that operator token; restrict its ACL.
GIFTS_OPERATOR_CREDENTIAL_FILE=
# Load the following only into the dedicated return-worker, never the API or delivery worker.
# Empty configuration and allowlist do not authorize model transmission.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
MODEL_API_KEY=
MODEL_ALLOWED_ACCOUNT_IDS=
