# Placeholder-only development configuration. Never commit real connection strings or credentials.
DATABASE_URL=postgresql://identity:CHANGE_ME@127.0.0.1:5433/xijie_identity
IDENTITY_HOST=127.0.0.1
IDENTITY_PORT=3101
OIDC_ISSUER=http://127.0.0.1:3001/oidc
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_CALLBACK_URL=http://127.0.0.1:5184/v1/auth/callback
XIJIE_PEOPLE_SERVICE_TOKEN=
XIJIE_CONVERSATIONS_SERVICE_TOKEN=
XIJIE_MEMORIES_SERVICE_TOKEN=
XIJIE_SOCIAL_SERVICE_TOKEN=
DATA_RIGHTS_ENABLED=false
XIJIE_DATA_RIGHTS_SERVICE_TOKEN=
DATA_EXPORT_ENCRYPTION_KEY=
XIJIE_PEOPLE_URL=http://127.0.0.1:3102
XIJIE_CONVERSATIONS_URL=http://127.0.0.1:3103
XIJIE_MEMORIES_URL=http://127.0.0.1:3104
# Keep unset for the legacy four-domain deployment. If set, Social cannot be skipped on failure.
# XIJIE_SOCIAL_URL=http://127.0.0.1:3105

# Invitation campaign is opt-in; production also requires explicit approval.
REFERRALS_ENABLED=false
REFERRALS_PRODUCTION_APPROVED=false
REFERRALS_TOKEN_KEY=
# Optional same public app origin; HTTPS or local loopback only.
# REFERRALS_PUBLIC_ORIGIN=http://127.0.0.1:5184

# Content review is independent of login and other service credentials.
CONTENT_REPORTS_ENABLED=false
XIJIE_CONTENT_REVIEW_SERVICE_TOKEN=
CONTENT_REVIEW_OPERATORS_FILE=
# Required when content review is enabled; never proxy /v1/ops or /internal publicly.
# XIJIE_SOCIAL_URL=http://127.0.0.1:3105
XIJIE_GIFTS_SERVICE_TOKEN=

# Login channels remain off until the matching official Logto connectors are configured.
OIDC_APPLE_ENABLED=false
OIDC_GOOGLE_ENABLED=false
OIDC_WECHAT_ENABLED=false
OIDC_NATIVE_HANDOFF_ENABLED=false
OIDC_WECHAT_NATIVE_ENABLED=false
LOGTO_WECHAT_NATIVE_CONNECTOR_ID=
WECHAT_NATIVE_APP_ID=
# Independent SELECT-only role on the fixed xijie_auth_reader.bound_phones view.
LOGTO_ACCOUNT_READ_DATABASE_URL=
# Alternative ONLY when this provider actually offers read:users (mutually exclusive).
LOGTO_ACCOUNT_READ_CLIENT_ID=
LOGTO_ACCOUNT_READ_CLIENT_SECRET=
LOGTO_ACCOUNT_READ_RESOURCE=
