DATABASE_URL=postgresql://memories:CHANGE_ME@127.0.0.1:5436/xijie_memories
MEMORIES_HOST=127.0.0.1
MEMORIES_PORT=3104
MEMORIES_WEB_ORIGIN=http://127.0.0.1:5184
XIJIE_IDENTITY_URL=http://127.0.0.1:3101
XIJIE_PEOPLE_URL=http://127.0.0.1:3102
XIJIE_CONVERSATIONS_URL=http://127.0.0.1:3103
XIJIE_MEMORIES_SERVICE_TOKEN=
XIJIE_CONVERSATIONS_SERVICE_TOKEN=
# Independent Social source consumer; no access to the general chat-memory context endpoint.
XIJIE_SOCIAL_SERVICE_TOKEN=
XIJIE_DATA_RIGHTS_SERVICE_TOKEN=
MEMORIES_QUEUE_SCHEMA=memory_queue
# Opt in only after fresh AI permission and review of the selected synthetic backlog.
# This operational switch never grants automatic-memory permission.
AUTOMATIC_MEMORY_ENABLED=false

# Load these only in separate candidate/automatic Workers, never into the API or browser.
# The current ai_text_processing policy permits only https://api.openai.com/v1.
MODEL_BASE_URL=
MODEL_NAME=
MODEL_API_KEY=
MODEL_ALLOWED_ACCOUNT_IDS=
# The automatic Worker pulls events only for these explicitly selected synthetic accounts.
# Start with one fresh account and a small reviewed backlog, not an unrestricted history sweep.
# This limit never replaces Identity AI authorization or automaticMemoryAllowed=true.
XIJIE_TEST_DATABASE_URL=

# Required when shared-contribution adoption is connected; fail closed when source is unavailable.
# XIJIE_SOCIAL_URL=http://127.0.0.1:3105
